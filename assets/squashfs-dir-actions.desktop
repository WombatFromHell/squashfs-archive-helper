[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/octet-stream;all/allfiles;inode/directory;
Actions=build-squashfs;build-squashfs-ask;
X-KDE-Submenu=Squish
X-KDE-Priority=TopLevel
Icon=utilities-file-archiver

[Desktop Action build-squashfs]
Name=Build
Icon=utilities-file-archiver
Exec=squish --kio %U

[Desktop Action build-squashfs-ask]
Name=Build with options
Icon=utilities-file-archiver
Exec=squish --prompt --kio %U
