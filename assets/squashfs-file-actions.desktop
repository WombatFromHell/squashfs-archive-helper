[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-squashfs;application/x-squashfs-image;application/vnd.squashfs;
Actions=verify-squashfs;extract-squashfs;mount-squashfs;unmount-squashfs;
X-KDE-Submenu=Squish
X-KDE-Priority=TopLevel
Icon=utilities-file-archiver

[Desktop Action verify-squashfs]
Name=Verify
Icon=dialog-ok
Exec=squish --check %f

[Desktop Action extract-squashfs]
Name=Extract
Icon=utilities-file-archiver
Exec=unsquish %f

[Desktop Action mount-squashfs]
Name=Mount
Icon=media-optical-mount
Exec=squish -m --open %f

[Desktop Action unmount-squashfs]
Name=Unmount
Icon=tools-media-optical-erase
Exec=squish -u %f
